<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The decision layer. Deliberately NOT built on Dalamud.NET.Sdk: this project must not be able
    to reference the game host even by accident, and the plainest way to guarantee that is to
    give it an SDK that never puts Dalamud on the reference path in the first place.

    TargetFramework is net10.0, not net10.0-windows. The plugin's net10.0-windows can consume
    this; the reverse is not true, and that asymmetry is the point - it is what stops a Windows-
    or game-only type leaking down into the decision layer.

    Platforms is x64 because the plugin is pinned to x64 by Dalamud.NET.Sdk. Building the plugin
    with -p:Platform=x64 propagates Platform=x64 into every project it references, and a project
    that only knows AnyCPU fails that build with an unset-OutputPath error rather than anything
    that names the real cause. Configurations is restated for the same reason.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The store. Three references and deliberately not a fourth.

      Microsoft.Data.Sqlite.CORE, not Microsoft.Data.Sqlite: the latter drags in
      SQLitePCLRaw.bundle_e_sqlite3, which initialises itself by loading "e_sqlite3" by BARE NAME.
      Dalamud already has its own e_sqlite3 resident in the FFXIV process, and Windows resolves a
      native import by base name against what is already loaded - so a bundle reference silently
      binds EMM to whatever version the host happens to be carrying. Pairing .Core with
      SQLitePCLRaw.core and the dynamic_cdecl provider is what lets SqliteEngine name the file it
      wants by full path. EorzeanMarketMaster.Tests asserts that no bare-name provider is present.

      The native library itself is NOT referenced here. A library does not get to decide which
      binary its host ships; the plugin and the test project each pull SQLitePCLRaw.lib.e_sqlite3
      and hand SqliteEngine the resulting path.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageReference Include="SQLitePCLRaw.provider.dynamic_cdecl" Version="3.0.5" />
  </ItemGroup>

</Project>
