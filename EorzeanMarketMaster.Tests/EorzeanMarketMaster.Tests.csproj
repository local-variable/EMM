<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <!--
    xunit against Core alone. No Dalamud reference here either: a test project that could load
    the game host would invite tests that need one, and the whole value of this seam is that it
    runs with no game, no network, no clock and no ImGui.

    Pinned to xunit.v3 3.2.2 rather than the 4.0.0 that shipped on 2026-08-15. 4.0.0 is a major
    version three days old at the time this project was created; 3.2.2 has been the settled v3
    release since 2026-01-14. Revisit once 4.x has some road behind it.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <Configurations>Debug;Release</Configurations>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      The store tests run against real SQLite, file-backed in a temp directory, so this project
      needs an actual e_sqlite3 to hand SqliteEngine.

      RuntimeIdentifier pins it to the one binary that matters. Without it SQLitePCLRaw.lib
      lays down all four RIDs (~7.5 MB) under runtimes/; with it, one 1.89 MB file lands in the
      output root, which is also where the plugin puts it - so the tests exercise the same layout
      the packaged plugin ships. AppendRuntimeIdentifierToOutputPath is off so that the output
      path stays bin/<Config>/net10.0/ and nothing downstream has to learn a new one.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />

    <!-- The native engine under test. Core deliberately does not reference this; see its csproj. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EorzeanMarketMaster.Core\EorzeanMarketMaster.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Recorded aggregator responses, laid down beside the test assembly so the parser is asserted
      against bodies that really came back rather than against a hand-written idea of them. See
      Ingest/IngestFixture.cs for what was changed in them and why.
    -->
    <Content Include="Ingest\Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
